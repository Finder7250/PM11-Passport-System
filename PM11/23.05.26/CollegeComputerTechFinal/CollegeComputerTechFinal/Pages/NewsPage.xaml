<Page x:Class="CollegeComputerTechFinal.Pages.NewsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Новости" Background="#F0F2F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Новости колледжа" FontSize="28" FontWeight="Bold" 
                   Foreground="#2C3E50" Margin="0,0,0,20"/>

        <ListBox Grid.Row="1" x:Name="NewsList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" 
                                       Foreground="#2C3E50"/>
                            <TextBlock Text="{Binding Date}" FontSize="11" 
                                       Foreground="#7F8C8D" Margin="0,5,0,5"/>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" 
                                       Foreground="#333333"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>