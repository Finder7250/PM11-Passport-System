<Page x:Class="CollegeComputerTechFinal.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Личный кабинет" Background="#F0F2F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Личный кабинет" FontSize="28" FontWeight="Bold" 
                   Foreground="#2C3E50" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20">
            <StackPanel>
                <TextBlock x:Name="txtFullName" FontSize="20" FontWeight="Bold" 
                           Foreground="#2C3E50" Margin="0,0,0,10"/>
                <TextBlock x:Name="txtRole" FontSize="14" Foreground="#3498DB" Margin="0,0,0,15"/>

                <Border Background="#F0F2F5" CornerRadius="8" Padding="15" Margin="0,10">
                    <StackPanel>
                        <TextBlock Text="Информация" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                        <TextBlock x:Name="txtCabinet" Margin="0,5"/>
                        <TextBlock x:Name="txtStats" Margin="0,5"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Page>